+        t("最后消费"), t("单数"), t("累计消费"), t("近 12 个月"), t("买过类别"), t("备注")],
+      agreed.map((c) => [waNumber(c.member_id), fmtMember(c.member_id), cleanName(c.name), t(TIER_LABEL[tierOf(c, settings)]),
