+              {rows.length === 0 && <tr><td colSpan={8} className="muted">{t("还没有活动")}</td></tr>}
+              {rows.map((c) => (
+                <tr key={c.id}>
+                  <td className="nowrap">{fmtDay(c.sent_on)}</td>
+                  <td>{c.name}{c.message && <div className="muted small">{c.message}</div>}</td>
+                  <td className="num">{fmtNum(c.members)}</td>
+                  <td className="num">
+                    {fmtNum(c.buyers_30)} ({pct(num(c.buyers_30), num(c.members))}){ended(c, 30) ? "" : ` · ${t("进行中")}`}
+                  </td>
+                  <td className="num">{fmtNum(c.revenue_30, 2)}</td>
+                  <td className="num">
+                    {fmtNum(c.buyers_60)} ({pct(num(c.buyers_60), num(c.members))}){ended(c, 60) ? "" : ` · ${t("进行中")}`}
+                  </td>
+                  <td className="num">{fmtNum(c.revenue_60, 2)}</td>
+                  <td className="nowrap">
+                    <button className="ghost small" onClick={() => exportMembers(c)}>{t("汇出名单")}</button>{" "}
+                    {isOwner && <button className="ghost small danger" onClick={() => remove(c)}>{t("删除")}</button>}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </section>
+  );
+}
+
+export function MonthlyReport({ settings }: { settings: Settings }) {
+  const [rows, setRows] = useState<Monthly[] | null>(null);
+  const [err, setErr] = useState("");
+  const [month, setMonth] = useState("");
+  const [agents, setAgents] = useState<Agent[] | null>(null);
+  const [agentsErr, setAgentsErr] = useState("");
+
+  const asked = useRef("");   // 最后点的月份：快速连点时，旧月份晚回来的结果丢掉
+  async function pick(m: string) {
+    asked.current = m;
+    setMonth(m);
+    setAgents(null);
+    setAgentsErr("");
+    const from = new Date(m.slice(0, 10) + "T00:00:00");
+    const to = new Date(from.getFullYear(), from.getMonth() + 1, 0);
+    try {
+      const r = await rpc<Agent[]>("bi_customer_agents", { p_from: localISO(from), p_to: localISO(to) });
+      if (asked.current === m) setAgents(r ?? []);
+    } catch (e) {
+      if (asked.current === m) setAgentsErr(errText(e));
+    }
+  }
+  useEffect(() => {
+    rpc<Monthly[]>("bi_customer_monthly", { p_months: 12 })
+      .then((r) => {
+        const data = (r ?? []).slice().reverse();
+        setRows(data);
+        if (data.length) pick(data[0].month);
+      })
+      .catch((e) => setErr(errText(e)));
+  }, []); // eslint-disable-line react-hooks/exhaustive-deps
+
+  return (
+    <section className="card">
+      <h2>{t("每月顾客报告")}</h2>
+      <p className="muted small">
+        {t("新客 = 那个月第一次买;回头客 = 以前买过、那个月又来;流失 = 最后一次消费满 {l} 天、在那个月变成流失的人数。只算门市散客,本月是到今天为止。", {
+          l: settings.lapsed_days })}
+      </p>
+      {err && <div className="error">{t("查询失败:")}{err}</div>}
+      {rows === null && !err && <p className="muted">{t("载入中…")}</p>}
+      {rows && (
+        <div className="cu-scroll">
+          <table>
+            <thead>
+              <tr>
+                <th>{t("月份")}</th><th className="num">{t("来买的顾客")}</th><th className="num">{t("新客")}</th>
+                <th className="num">{t("回头客")}</th><th className="num">{t("回头客占比")}</th>
+                <th className="num">{t("新客营业额")}</th><th className="num">{t("回头客营业额")}</th><th className="num">{t("流失")}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((r) => (
+                <tr key={r.month} className={"click" + (r.month === month ? " cu-sel" : "")} onClick={() => pick(r.month)}>
+                  <td className="nowrap">{r.month.slice(0, 7)}</td>
+                  <td className="num">{fmtNum(r.active)}</td>
+                  <td className="num">{fmtNum(r.new_customers)}</td>
+                  <td className="num">{fmtNum(r.returning_customers)}</td>
+                  <td className="num">{pct(num(r.returning_customers), num(r.active))}</td>
+                  <td className="num">{fmtNum(r.new_revenue, 2)}</td>
+                  <td className="num">{fmtNum(r.returning_revenue, 2)}</td>
+                  <td className="num">{fmtNum(r.lapsed)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+      {month && (
+        <>
+          <h3>{t("{m} 各业务员的顾客", { m: month.slice(0, 7) })}</h3>
+          {agentsErr && <div className="error">{t("查询失败:")}{agentsErr}</div>}
+          {agents === null && !agentsErr && <p className="muted">{t("载入中…")}</p>}
+          {agents && (
+            <div className="cu-scroll">
+              <table>
+                <thead>
+                  <tr>
+                    <th>{t("业务员")}</th><th className="num">{t("顾客")}</th><th className="num">{t("回头客")}</th>
+                    <th className="num">{t("新客")}</th><th className="num">{t("营业额")}</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {agents.length === 0 && <tr><td colSpan={5} className="muted">{t("这个月没有门市散客的单")}</td></tr>}
+                  {agents.map((a) => (
+                    <tr key={a.agent}>
+                      <td>{a.agent}</td>
+                      <td className="num">{fmtNum(a.customers)}</td>
+                      <td className="num">{fmtNum(a.returning_customers)}</td>
+                      <td className="num">{fmtNum(a.new_customers)}</td>
+                      <td className="num">{fmtNum(a.revenue, 2)}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
+
+export function MissingPhone() {
+  const [rows, setRows] = useState<Missing[] | null>(null);
+  const [err, setErr] = useState("");
+
+  async function load() {
+    try {
+      setRows(await rpc<Missing[]>("bi_customer_missing_phone", { p_days: 60 }) ?? []);
+      setErr("");
+    } catch (e) {
+      setErr(errText(e));
+    }
+  }
+
+  return (
+    <details className="card" onToggle={(e) => { if ((e.target as HTMLDetailsElement).open && rows === null) load(); }}>
+      <summary><b>{t("没抓到电话的门市单据(近 60 天)")}</b></summary>
+      <p className="muted small">
+        {t("这些单的客户名称没有手机号(或号码少一位),顾客不会出现在名单里。请在 AutoCount 把客户名称改成「名字 + 手机号」,隔天同步后就会补上。")}
+      </p>
+      {err && <div className="error">{t("查询失败:")}{err}</div>}
+      {rows === null && !err && <p className="muted">{t("载入中…")}</p>}
+      {rows && (
+        <div className="cu-scroll">
+          <table>
+            <thead>
+              <tr><th>{t("日期")}</th><th>{t("门市")}</th><th>{t("单号")}</th><th>{t("单上客户名称")}</th><th>{t("业务员")}</th><th className="num">{t("金额")}</th></tr>
+            </thead>
+            <tbody>
+              {rows.length === 0 && <tr><td colSpan={6} className="muted">{t("全部都有电话 👍")}</td></tr>}
+              {rows.map((x) => (
+                <tr key={`${x.company}|${x.doc_type}|${x.doc_no}`}>
+                  <td className="nowrap">{fmtDay(x.doc_date)}</td>
+                  <td>{STORE[x.company] ?? x.company}</td>
+                  <td className="nowrap">{x.doc_no}</td>
+                  <td>{x.debtor_name} <span className="muted">({x.debtor_code})</span></td>
+                  <td>{x.sales_agent}</td>
+                  <td className="num">{fmtNum(x.amount, 2)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </details>
+  );
+}
diff --git a/portal/src/cust/SettingsTab.tsx b/portal/src/cust/SettingsTab.tsx
new file mode 100644
index 0000000..7e47f4d
--- /dev/null
+++ b/portal/src/cust/SettingsTab.tsx
@@ -0,0 +1,144 @@
+// 顾客资料 · 设定（可审批）：分级门槛与提醒天数（只有管理员能改）、WhatsApp 范本、顾客扫码登记的 QR 网址
+import { Fragment, useEffect, useRef, useState } from "react";
+import { BI_SITE, errText, num, rpc, Settings, STAGES, t, Template } from "../cust-api";
+
+type Msg = { ok: boolean; text: string } | null;
+
+function toForm(s: Settings) {
+  return {
+    vip: String(s.vip_min_12m), docs: String(s.regular_min_docs), lapsed: String(s.lapsed_days),
+    lead: String(s.lead_follow_days), bday: String(s.birthday_days),
+    quote: String(s.quote_follow_days), qmax: String(s.quote_max_days), stage: String(s.stage_follow_days),
+    reco: Object.fromEntries(STAGES.map(([k]) => [k, (s.stage_reco?.[k] ?? []).join(", ")])) as Record<string, string>,
+  };
+}
+
+export function SettingsTab({ isOwner, loaded, settings, templates, onChanged }: {
+  isOwner: boolean; loaded: boolean; settings: Settings; templates: Template[]; onChanged: () => void;
+}) {
+  const [s, setS] = useState(() => toForm(settings));
+  const [msg, setMsg] = useState<Msg>(null);
+  const [edit, setEdit] = useState<Template | null>(null);
+  const [busy, setBusy] = useState(false);
+  const dirty = useRef(false);   // 门槛改了还没存：存范本后重新载入设定时不盖掉
+  useEffect(() => { if (!dirty.current) setS(toForm(settings)); }, [settings]);
+
+  async function run(f: () => Promise<unknown>): Promise<boolean> {
+    setBusy(true); setMsg(null);
+    try { await f(); setMsg({ ok: true, text: t("已储存。") }); onChanged(); return true; }
+    catch (e) { setMsg({ ok: false, text: errText(e) }); return false; }
+    finally { setBusy(false); }
+  }
+
+  const saveSettings = () => run(async () => {
+    await rpc("bi_customer_set_settings", {
+      p_vip_min_12m: num(s.vip), p_regular_min_docs: num(s.docs), p_lapsed_days: num(s.lapsed),
+      p_lead_follow_days: num(s.lead), p_birthday_days: num(s.bday),
+      p_quote_follow_days: num(s.quote), p_quote_max_days: num(s.qmax), p_stage_follow_days: num(s.stage),
+      p_stage_reco: Object.fromEntries(Object.entries(s.reco).map(([k, v]) => [k,
+        v.split(/[,，\s]+/).map((x) => x.trim().toUpperCase()).filter(Boolean)])),
+    });
+    dirty.current = false;
+  });
+
+  async function saveTemplate() {
+    if (!edit) return;
+    const e = edit;
+    if (await run(() => rpc("bi_wa_template_save", { p_id: e.id || null, p_title: e.title, p_body: e.body, p_sort: num(e.sort) }))) {
+      setEdit(null);
+    }
+  }
+
+  function removeTemplate(x: Template) {
+    if (!window.confirm(t("删除范本「{n}」?", { n: x.title }))) return;
+    run(() => rpc("bi_wa_template_delete", { p_id: x.id }));
+  }
+
+  const upd = (k: Exclude<keyof typeof s, "reco">) => (e: { target: { value: string } }) => {
+    dirty.current = true;
+    setS({ ...s, [k]: e.target.value });
+  };
+  const field = (label: string, k: Exclude<keyof typeof s, "reco">) => (
+    <label>{t(label)}<input value={s[k]} onChange={upd(k)} inputMode="numeric" /></label>
+  );
+
+  return (
+    <>
+      {msg && <div className={msg.ok ? "ok" : "error"}>{msg.text}</div>}
+      <div className="cu-forms">
+        <section className="card cu-form">
+          <h2>{t("分级与提醒")}</h2>
+          {!loaded && <p className="muted small">{t("载入中…")}</p>}
+          <fieldset className="plain" disabled={!isOwner || busy || !loaded}>
+            {field("VIP:近 12 个月消费至少 (RM)", "vip")}
+            {field("常客:近 12 个月至少几张单", "docs")}
+            {field("流失:超过几天没来", "lapsed")}
+            {field("潜在客:建档几天没联络就提醒", "lead")}
+            {field("生日:提前几天提醒", "bday")}
+            {field("报价:开出几天还没成交就提醒", "quote")}
+            {field("报价:超过几天就不再追", "qmax")}
+            {field("装修进度:几天没更新就提醒", "stage")}
+            <h3>{t("各装修阶段推荐的类别")}</h3>
+            <div className="muted small">{t("填 AutoCount 的 Item Group,用逗号分开,例:SANITARY, KITCHEN")}</div>
+            {STAGES.map(([k, v]) => (
+              <Fragment key={k}>
+                <label>{t(v)}
+                  <input value={s.reco[k] ?? ""} onChange={(e) => { dirty.current = true; setS({ ...s, reco: { ...s.reco, [k]: e.target.value } }); }} />
+                </label>
+              </Fragment>
+            ))}
+            {isOwner && <div className="actions left"><button onClick={saveSettings}>{t("储存")}</button></div>}
+          </fieldset>
+          {!isOwner && <p className="muted small">{t("只有管理员可以改分级门槛与提醒天数。")}</p>}
+        </section>
+
+        <section className="card cu-form">
+          <h2>{t("WhatsApp 范本")}</h2>
+          <div className="muted small">{t("内容里的 {name} 会换成顾客名字。")}</div>
+          {templates.map((x) => (
+            <div key={x.id} className="cu-tpl">
+              <b>{x.title}</b>
+              <div className="muted small pre">{x.body}</div>
+              <div className="actions left">
+                <button className="ghost small" disabled={busy} onClick={() => setEdit({ ...x })}>{t("修改")}</button>
+                <button className="ghost small danger" disabled={busy} onClick={() => removeTemplate(x)}>{t("删除")}</button>
+              </div>
+            </div>
+          ))}
+          {!edit && (
+            <div className="actions left">
+              <button className="ghost" onClick={() => setEdit({ id: 0, title: "", body: "Hi {name}，", sort: templates.length + 1 })}>
+                {t("新增范本")}
+              </button>
+            </div>
+          )}
+          {edit && (
+            <div className="form cu-box">
+              <label>{t("标题(按钮上显示)")}<input value={edit.title} onChange={(e) => setEdit({ ...edit, title: e.target.value })} /></label>
+              <label>{t("内容")}<textarea rows={4} value={edit.body} onChange={(e) => setEdit({ ...edit, body: e.target.value })} /></label>
+              <label>{t("排序")}
+                <input value={String(edit.sort)} onChange={(e) => setEdit({ ...edit, sort: num(e.target.value) })} inputMode="numeric" />
+              </label>
+              <div className="actions left">
+                <button disabled={busy} onClick={saveTemplate}>{t("储存")}</button>
+                <button className="ghost" onClick={() => setEdit(null)}>{t("取消")}</button>
+              </div>
+            </div>
+          )}
+        </section>
+
+        <section className="card cu-form">
+          <h2>{t("顾客自己登记的 QR")}</h2>
+          <div className="muted small">
+            {t("把下面网址做成 QR 贴在柜台;顾客扫码填完就直接存进顾客资料,在「跟进」分页的「最近扫码登记的顾客」看得到。")}
+          </div>
+          {["HQ", "JB"].map((st) => (
+            <div key={st} className="small">
+              <b>{st}</b>: <a href={`${BI_SITE}/join.html?s=${st}`} target="_blank" rel="noreferrer">{`${BI_SITE}/join.html?s=${st}`}</a>
+            </div>
+          ))}
+        </section>
+      </div>
+    </>
+  );
+}
