+              {Array.from({ length: 12 }, (_, i) => <option key={i} value={i + 1}>{i + 1}</option>)}
+            </select>
+            <select value={f.bd} onChange={upd("bd")}>
+              <option value="">{t("日")}</option>
+              {Array.from({ length: 31 }, (_, i) => <option key={i} value={i + 1}>{i + 1}</option>)}
+            </select>
+          </span>
+        </label>
+        <label>{t("同意收促销讯息")}
