+  [/^还有 (\d+) 站要送$/, (m) => `${m[1]} stop(s) left`],
+  [/^今天还有 (\d+) 站没签收$/, (m) => `${m[1]} stop(s) not signed off today`],
+  [/^已载入 (\d+) 站。可以改司机、增减站，再传一次。$/, (m) => `Loaded ${m[1]} stop(s). Change the driver or stops, then send again.`],
+  [/^已排好。(\d+) 站只找到邮区的大概位置，最好按「改位置」贴准确的 Google Maps 坐标。$/,
+    (m) => `Done. ${m[1]} stop(s) only matched a postcode area — tap "Fix location" and paste exact Google Maps coordinates.`],
+  [/^📷 (\d+) 张$/, (m) => `📷 ${m[1]}`],
+  [/^出发点（(.+)）$/, (m, t) => `Starting point (${t(m[1])})`],
+  [/^不再列出司机 (.+)？$/, (m) => `Stop listing driver ${m[1]}?`],
+  [/^找不到 DO (.+)。$/, (m) => `DO ${m[1]} not found.`],
+  [/^找不到司机 #(\d+)。$/, (m) => `Driver #${m[1]} not found.`],
+  [/^未知的司机种类：(.+)$/, (m) => `Unknown driver type: ${m[1]}`],
+];
