+.dv-stop.dv-failed { border-color: var(--red); }
+.dv-title { display: flex; gap: 10px; align-items: center; cursor: pointer; }
+.dv-no { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 600; }
+.dv-main { flex: 1; min-width: 0; }
