+.dv-thumb button { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; border-radius: 50%; padding: 0; background: var(--red); font-size: .75rem; }
+.dv label.dv-note { margin-top: 10px; }
+.dv .dv-actions button { flex: 1; padding: 12px; font-size: 1rem; }
+.dv .dv-actions button.dv-ok { background: var(--green); }
+.dv .dv-actions button.dv-no-btn { background: var(--red); flex: 0 0 auto; padding: 12px 16px; }
+.dv-redo { margin-top: 8px; }
+
+/* 手机：排单表改成一站一张卡（表格横向太挤） */
+@media (max-width: 700px) {
+  table.dlv-stops thead { display: none; }
+  table.dlv-stops, table.dlv-stops tbody, table.dlv-stops tr, table.dlv-stops td { display: block; width: 100%; }
+  table.dlv-stops tr { position: relative; padding: 10px 0 12px; border-bottom: 1px solid var(--line); }
+  table.dlv-stops tr:last-child { border-bottom: 0; }
+  table.dlv-stops td { border: 0; padding: 3px 0; min-width: 0; }
+  table.dlv-stops td:first-child { position: absolute; top: 10px; right: 0; width: auto; color: var(--muted); }
+  table.dlv-stops td:nth-child(2) { font-weight: 600; }
+  table.dlv-stops td:last-child { display: flex; gap: 6px; }
+}
