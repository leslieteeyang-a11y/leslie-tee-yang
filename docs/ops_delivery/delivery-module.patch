+
+/* 司机签收（#/driver 不用登入的页面与「我的送货」共用） */
+.dv-page { max-width: 560px; margin: 0 auto; padding: 16px 12px 40px; }
+.dv { max-width: 560px; }
+.dv-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
