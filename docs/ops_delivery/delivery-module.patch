+.dv-tag { display: inline-block; margin-left: 6px; font-size: .75rem; padding: 1px 8px; border-radius: 10px; color: #fff; }
+.dv-tag-delivered { background: var(--green); }
+.dv-tag-failed { background: var(--red); }
+.dv-addr { margin: 10px 0 6px; }
+.dv-actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
+.dv a.dv-btn { flex: 1; text-align: center; padding: 10px; border: 1px solid var(--line); border-radius: 8px; color: var(--text); background: var(--bg); font-size: .9rem; }
+.dv-warn { background: var(--amber-soft); color: var(--amber); border-radius: 8px; padding: 8px 10px; margin: 8px 0; font-weight: 600; }
+.dv-muted { color: var(--muted); font-size: .9rem; margin: 6px 0; }
+.dv-goods { margin: 8px 0; }
+.dv label.dv-line { color: var(--text); font-size: .95rem; margin-top: 6px; }
+.dv label.dv-line input { width: 20px; height: 20px; flex: none; }
+.dv label.dv-photo { display: block; text-align: center; margin-top: 12px; padding: 14px; border: 2px dashed var(--blue); border-radius: 10px; color: var(--blue); font-weight: 600; cursor: pointer; }
+.dv-photo input { display: none; }
